rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Établissements de loisirs : Consultation et synchronisation terrain souveraine
    match /establishments/{establishmentId} {
      allow read, write: if true;
    }

    // Quittances de régie SAF Trésor (Contrôle d'authenticité et synchronisation régie)
    match /receipts/{receiptId} {
      allow read, write: if true;
    }

    // Planning et tournées de terrain des inspecteurs SAA
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Actes de police administrative et sanctions
    match /legalActs/{legalActId} {
      allow read, write: if true;
    }

    // Autorisations d'exploitation départementales
    match /departmentalAuthorizations/{authId} {
      allow read, write: if true;
    }

    // Campagnes de relance et vœux 2026-2027
    match /campaignBatches/{batchId} {
      allow read, write: if true;
    }

    match /campaignMessages/{msgId} {
      allow read, write: if true;
    }

    // Journal d'audit certifié SHA-256
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Test de connectivité
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
