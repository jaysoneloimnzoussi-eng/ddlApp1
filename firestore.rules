rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Custom claims must be assigned with the Firebase Admin SDK:
    // { role: 'administrateur' | 'directeur' | 'inspecteur_saa',
    //   agentId: '<staff id>' }
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'administrateur' || role() == 'directeur';
    }

    function isFieldAgent() {
      return role() == 'inspecteur_saa';
    }

    function isAssignedAgent() {
      return isFieldAgent()
        && request.auth.token.agentId != null
        && request.auth.token.agentId == request.resource.data.agentAssigneId;
    }

    match /establishments/{establishmentId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || isAssignedAgent();
      allow delete: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || isAssignedAgent();
      allow delete: if isAdmin();
    }

    match /receipts/{receiptId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /legalActs/{legalActId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /departmentalAuthorizations/{authId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /campaignBatches/{batchId} {
      allow read, write: if isAdmin();
    }

    match /campaignMessages/{msgId} {
      allow read, write: if isAdmin();
    }

    // Logs are append-only. A privileged service should be used for any
    // correction, rather than permitting client-side mutation.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /test/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
