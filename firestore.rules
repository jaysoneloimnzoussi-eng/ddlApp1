rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Établissements de loisirs : Consultation publique/agents, écriture réservée aux agents authentifiés
    match /establishments/{establishmentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Quittances de régie SAF Trésor (Données financières sensibles : accès restreint)
    match /receipts/{receiptId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Planning et tournées de terrain des brigades
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Actes de police administrative et sanctions
    match /legalActs/{legalActId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Journal d'audit immuable SHA-256 (Protection anti-falsification)
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immuabilité garantie
    }

    // Test de connectivité
    match /test/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
